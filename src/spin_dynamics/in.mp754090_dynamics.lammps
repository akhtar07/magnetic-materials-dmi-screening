# Finite-T Langevin spin-dynamics stage for mp-754090 (Li4Fe2TeWO12). D is now DFT-derived
# (paramrudra jobs 49186/49187, constrained noncollinear+SOC canting probe) -- see
# in.mp754090_effective.lammps for the full J and D derivation, and the caveat that D's
# direction (y, in the arbitrary lab frame used for the probe) is a resolved-but-not-fully-3D
# DMI component, not a complete DMI vector fit. Anisotropy remains unprobed (set to 0).
#
# Run via run_scan_parallel_mp754090.sh, one temperature/seed per invocation:
#   -var runtemp <K> -var runseed <int>
#
# Same LAMMPS-build workaround as in.pdfeir_dynamics.lammps: hybrid/overlay segfaults with
# exactly 2 spin substyles on this build, padded to 3 with a zero-strength spin/magelec term.

units           metal
atom_style      spin
dimension       3
boundary        p p p
atom_modify     map array

read_restart    restart.mp754090_T0.equil

variable        j_eff_eV equal 0.012058385
variable        d_shell equal 5.132075
variable        exch_a equal v_j_eff_eV*2.718281828/4.0
variable        rc_exch equal 5.25
variable        d_eV equal 0.00019324
variable        rc_dmi equal 5.25

pair_style      hybrid/overlay spin/exchange ${rc_exch} spin/dmi ${rc_dmi} spin/magelec ${rc_exch}
pair_coeff      * * spin/exchange exchange ${rc_exch} ${exch_a} 0.0 ${d_shell} offset yes
pair_coeff      * * spin/dmi dmi ${rc_dmi} ${d_eV} 0.0 1.0 0.0
pair_coeff      * * spin/magelec magelec ${rc_exch} 0.0 1.0 1.0 1.0   # zero strength: segfault workaround only

neighbor        0.3 bin
neigh_modify    every 10 check yes delay 20

fix             1 all precession/spin zeeman 0.0 0.0 0.0 1.0
fix_modify      1 energy yes
fix             2 all langevin/spin ${runtemp} 0.05 ${runseed}
fix             3 all nve/spin lattice frozen

timestep        0.0001

compute         out_mag all spin
compute         outsp all property/atom spx spy spz sp
thermo_style    custom step time temp pe etotal c_out_mag[4] c_out_mag[5]
thermo          200

dump            1 all custom 500 dump_mp754090_T${runtemp}_s${runseed}.lammpstrj type x y z c_outsp[1] c_outsp[2] c_outsp[3]

# Coarse first pass -- 20k steps @ dt=0.0001 ps = 2 ps, same length as pdfeir's first pass.
run             20000

print           "DYNAMICS_T${runtemp}_DONE"
