# mp-754090: relax an isolated skyrmion at B = 0.015605479 T, K = -1.3968433e-06 eV
# (reference point B = 1.7 T, K = -0.00011 eV; h = 0.28918, kappa = -0.05388)
units metal
atom_style spin
boundary p p f
atom_modify map array
timestep 0.0394
read_data ../../seed.data
pair_style hybrid/overlay lj/cut 7.007710 spin/exchange 7.007710 spin/dmi 7.007710
pair_coeff * * lj/cut 0.0 1.0
pair_coeff * * spin/exchange exchange 7.007710 0.00189202569392 0 5.2733445388
pair_coeff * * spin/dmi dmi 7.007710 0.000155 0.0 0.0 1.0
compute eEX all pair spin/exchange
compute eDMI all pair spin/dmi
compute outsp all property/atom spx spy spz sp
compute sz all property/atom spz
compute msz all reduce ave c_sz
variable Mz equal c_msz
fix f1 all precession/spin zeeman 0.01560547873 0.0 0.0 1.0 anisotropy -1.396843342e-06 0.0 0.0 1.0
fix_modify f1 energy yes
thermo 1000
thermo_style custom step pe c_eEX c_eDMI f_f1 v_Mz
thermo_modify format float %.12f
fix f2 all langevin/spin 0.00001 1.0 123456
fix f3 all nve/spin lattice frozen
dump d1 all custom 10000 traj.dump id type x y z c_outsp[1] c_outsp[2] c_outsp[3] c_outsp[4]
run 40000
undump d1
write_dump all custom final.dump id type x y z c_outsp[1] c_outsp[2] c_outsp[3] c_outsp[4] modify format float %.10f
